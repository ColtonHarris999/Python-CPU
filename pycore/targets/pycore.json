      "hw_class": "FRAME",
      "fold": "BAR"
    },
    "CALL_KW": {
      "support": "execute",
      "hw_class": "FRAME",
      "fold": "BAR",
      "note": "CODE_OBJECT binder via co_varnames; OBK_BUILTIN/TYPE kwargs → CALL_FILTER"
    },
    "CALL_FUNCTION_EX": {
      "support": "execute",
      "hw_class": "FRAME",
      "fold": "BAR",
      "note": "LIST/TUPLE *args expand; kwargs dict via shared binder; NULL = no kwargs"
    },
    "DICT_MERGE": {
      "support": "partial",
      "hw_class": "OBJECT",
      "fold": "BAR",
      "note": "Empty-dest alias fast path; non-empty uncontaminated dest → excore DICT_MERGE trap; contaminated dest/src → CALL_FILTER"
    },
    "DICT_UPDATE": {
      "support": "partial",
      "hw_class": "OBJECT",
      "fold": "BAR",
      "note": "Uncontaminated A.update(B) → excore DICT_UPDATE trap (grow-to-fit, overwrite dups); contaminated → type trap (pycore bulk update gap)"
    },
    "MAP_ADD": {
