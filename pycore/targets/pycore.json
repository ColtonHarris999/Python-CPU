{
  "name": "pycore",
  "python_version": "3.14",
  "support_levels": {
    "execute": {
      "severity": "info",
      "remediation": "none"
    },
    "partial": {
      "severity": "warn",
      "remediation": "hardware"
    },
    "strip": {
      "severity": "info",
      "remediation": "none"
    },
    "trap": {
      "severity": "error",
      "remediation": "hardware"
    },
    "reject": {
      "severity": "error",
      "remediation": "hardware"
    }
  },
  "hw_classes": {
    "//": "fit/needs_leaf are INTRINSIC (scalar stack-CPU design point), independent of support. needs_leaf names the datapath unit KIND required; current_module is the existing RTL instance or null if not built yet.",
    "REG": {
      "fit": "native",
      "latency": "fixed1",
      "needs_leaf": "register file / decode",
      "current_module": "pycore_regfile",
      "why": "register-file index read/write; no compute"
    },
    "IMM": {
      "fit": "native",
      "latency": "fixed0",
      "needs_leaf": "decode immediate",
      "current_module": "pycore_decode",
      "why": "value materialized from oparg at decode"
    },
    "CONST": {
      "fit": "costly",
      "latency": "mem1",
      "needs_leaf": "constant ROM (mem stage)",
      "current_module": "pycore_const_table",
      "why": "ROM read; loop-hoistable"
    },
    "ALU1": {
      "fit": "native",
      "latency": "fixed1",
      "needs_leaf": "integer ALU",
      "current_module": "pycore_int_alu",
      "why": "single-cycle integer/bitwise leaf"
    },
    "ALUN": {
      "fit": "costly",
      "latency": "multi",
      "needs_leaf": "multiplier / divider / FPU",
      "current_module": "pycore_mul/pycore_div/pycore_fpu",
      "why": "multi-cycle bounded numeric (mul/div/rem/pow/fpu)"
    },
    "PRED": {
      "fit": "native",
      "latency": "fixed1",
      "needs_leaf": "compare + branch unit",
      "current_module": "pycore_int_alu/pycore_branch",
      "why": "comparison/truthiness producing a bool"
    },
    "BRANCH": {
      "fit": "native",
      "latency": "fixed1",
      "needs_leaf": "branch unit",
      "current_module": "pycore_branch/pycore_fetch",
      "why": "static-target control transfer / markers"
    },
    "FRAME": {
      "fit": "heavy",
      "latency": "multi",
      "needs_leaf": "frame/call engine",
      "current_module": "pycore_frame",
      "why": "call/return needs frame alloc + spill (intrinsically heavy on any target)"
    },
    "OBJECT": {
      "fit": "infeasible",
      "latency": "n/a",
      "needs_leaf": "heap/object protocol (outside scalar design point)",
      "current_module": null,
      "suppress": true,
      "why": "needs runtime objects/dicts/iterators; cannot map to a scalar tagged-value datapath"
    },
    "INTERNAL": {
      "fit": "n/a",
      "latency": "n/a",
      "needs_leaf": null,
      "current_module": null,
      "suppress": true,
      "why": "interpreter plumbing (INSTRUMENTED_*, CACHE, RESERVED, EXTENDED_ARG, ENTER_EXECUTOR, INTERPRETER_EXIT, JUMP/JUMP_NO_INTERRUPT pseudo, ANNOTATIONS_PLACEHOLDER); never reaches a hardware target -> strip, not a gap"
    }
  },
  "obj_groups": {
    "//": "Sub-axis of hw_class=OBJECT only (all fit=infeasible, suppressed). needs_subsystem = runtime subsystem required; distance = how far beyond the scalar design point (D1 nearest .. D5 = whole runtime). Members partition the 88 OBJECT opcodes exactly (CALL is FRAME, not OBJECT). Powers the --include-out-of-scope expansion roadmap; does NOT affect default findings/backlog.",
    "OBJ_SEQ": {
      "distance": 1,
      "needs_subsystem": "typed array/memory unit + bounds check",
      "members": [
        "STORE_SUBSCR",
        "DELETE_SUBSCR",
        "BINARY_SLICE",
        "STORE_SLICE",
        "GET_LEN",
        "UNPACK_SEQUENCE",
        "UNPACK_EX"
      ],
      "also_via_oparg": "BINARY_OP[NB_SUBSCR=26] is the subscript READ (x[i]); BINARY_OP[NB_MATRIX_MULTIPLY=4/17] is @; both routed here from BINARY_OP.obj_group_by_arg, not standalone opcodes in 3.14"
    },
    "OBJ_DYN": {
      "distance": 1,
      "needs_subsystem": "reference identity / container membership",
      "members": [
        "IS_OP",
        "CONTAINS_OP"
      ]
    },
    "OBJ_STR": {
      "distance": 2,
      "needs_subsystem": "string buffer + format runtime",
      "members": [
        "FORMAT_SIMPLE",
        "FORMAT_WITH_SPEC",
        "CONVERT_VALUE",
        "BUILD_STRING",
        "BUILD_INTERPOLATION",
        "BUILD_TEMPLATE"
      ]
    },
    "OBJ_CLOSURE": {
      "distance": 2,
      "needs_subsystem": "heap cell boxes for free vars",
      "members": [
        "MAKE_CELL",
        "LOAD_DEREF",
        "STORE_DEREF",
        "DELETE_DEREF",
        "LOAD_FROM_DICT_OR_DEREF",
        "COPY_FREE_VARS",
        "LOAD_CLOSURE"
      ]
    },
    "OBJ_BUILD": {
      "distance": 2,
      "needs_subsystem": "heap allocator + container reprs",
      "members": [
        "BUILD_LIST",
        "BUILD_TUPLE",
        "BUILD_SET",
        "BUILD_MAP",
        "BUILD_SLICE",
        "LIST_APPEND",
        "LIST_EXTEND",
        "SET_ADD",
        "SET_UPDATE",
        "MAP_ADD",
        "DICT_UPDATE",
        "DICT_MERGE"
      ]
    },
    "OBJ_NS": {
      "distance": 3,
      "needs_subsystem": "dict + hashing (+ descriptor/MRO for attrs)",
      "members": [
        "LOAD_GLOBAL",
        "STORE_GLOBAL",
        "DELETE_GLOBAL",
        "LOAD_NAME",
        "STORE_NAME",
        "DELETE_NAME",
        "LOAD_ATTR",
        "STORE_ATTR",
        "DELETE_ATTR",
        "LOAD_SUPER_ATTR",
        "IMPORT_NAME",
        "IMPORT_FROM",
        "LOAD_BUILD_CLASS",
        "LOAD_FROM_DICT_OR_GLOBALS",
        "LOAD_LOCALS",
        "LOAD_SPECIAL",
        "LOAD_COMMON_CONSTANT",
        "SETUP_ANNOTATIONS"
      ]
    },
    "OBJ_ITER": {
      "distance": 4,
      "needs_subsystem": "iterator-protocol dispatch (tp_iter/tp_next)",
      "members": [
        "GET_ITER",
        "FOR_ITER",
        "END_FOR",
        "GET_YIELD_FROM_ITER",
        "GET_AITER",
        "GET_ANEXT",
        "END_ASYNC_FOR",
        "GET_AWAITABLE"
      ]
    },
    "OBJ_MATCH": {
      "distance": 4,
      "needs_subsystem": "type introspection + container probing",
      "members": [
        "MATCH_CLASS",
        "MATCH_KEYS",
        "MATCH_MAPPING",
        "MATCH_SEQUENCE"
      ]
    },
    "OBJ_GEN": {
      "distance": 5,
      "needs_subsystem": "suspendable/resumable frames",
      "members": [
        "SEND",
        "END_SEND",
        "YIELD_VALUE",
        "RETURN_GENERATOR",
        "CLEANUP_THROW"
      ]
    },
    "OBJ_EXC": {
      "distance": 5,
      "needs_subsystem": "exception state + stack unwinder",
      "members": [
        "PUSH_EXC_INFO",
        "POP_EXCEPT",
        "RERAISE",
        "CHECK_EXC_MATCH",
        "CHECK_EG_MATCH",
        "WITH_EXCEPT_START",
        "RAISE_VARARGS",
        "POP_BLOCK",
        "SETUP_FINALLY",
        "SETUP_WITH",
        "SETUP_CLEANUP",
        "EXIT_INIT_CHECK"
      ]
    },
    "OBJ_CALL": {
      "distance": 5,
      "needs_subsystem": "full call/object-construction protocol (variadic + func-object creation; CALL/CALL_KW/CALL_FUNCTION_EX are FRAME, in-scope)",
      "members": [
        "CALL_INTRINSIC_1",
        "CALL_INTRINSIC_2",
        "MAKE_FUNCTION",
        "SET_FUNCTION_ATTRIBUTE",
        "PUSH_NULL"
      ]
    }
  },
  "opcodes": {
    "LOAD_FAST": {
      "support": "execute",
      "hw_class": "REG",
      "fold": "SRC",
      "pushes": 1
    },
    "LOAD_FAST_BORROW": {
      "support": "execute",
      "hw_class": "REG",
      "fold": "SRC",
      "pushes": 1
    },
    "LOAD_FAST_CHECK": {
      "support": "execute",
      "hw_class": "REG",
      "fold": "SRC",
      "pushes": 1,
      "note": "== LOAD_FAST under PyCore UNINITIALIZED-trap policy"
    },
    "COPY": {
      "support": "execute",
      "hw_class": "REG",
      "fold": "SRC",
      "pushes": 1
    },
    "SWAP": {
      "support": "execute",
      "hw_class": "REG",
      "fold": "BAR"
    },
    "STORE_FAST": {
      "support": "execute",
