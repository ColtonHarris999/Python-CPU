      "hw_class": "BRANCH",
      "fold": "BAR",
      "note": "None identity test; no None scalar in PyCore"
    },
    "POP_JUMP_IF_NOT_NONE": {
      "support": "execute",
      "hw_class": "BRANCH",
      "fold": "BAR",
      "note": "None identity test; no None scalar in PyCore"
    },
    "JUMP_IF_TRUE": {
      "support": "reject",
      "hw_class": "BRANCH",
      "fold": "BAR",
      "note": "3.14 peek-branch (net 0, does not pop)"
    },
    "JUMP_IF_FALSE": {
      "support": "reject",
      "hw_class": "BRANCH",
      "fold": "BAR",
      "note": "3.14 peek-branch (net 0, does not pop); replaces 3.13 JUMP_IF_FALSE_OR_POP"
    },
    "JUMP_BACKWARD_NO_INTERRUPT": {
      "support": "reject",
      "hw_class": "BRANCH",
      "fold": "BAR"
