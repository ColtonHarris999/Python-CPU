    },
    "DELETE_FAST": {
      "support": "execute",
      "hw_class": "REG",
      "fold": "BAR"
    },
    "LOAD_SMALL_INT": {
      "support": "execute",
      "hw_class": "IMM",
      "fold": "SRC",
      "pushes": 1
    },
    "LOAD_CONST": {
      "support": "execute",
      "hw_class": "CONST",
      "fold": "SRC",
      "pushes": 1
    },
    "UNARY_NEGATIVE": {
      "support": "execute",
      "hw_class": "ALU1",
      "fold": "UNY"
    },
    "UNARY_INVERT": {
      "support": "execute",
      "hw_class": "ALU1",
      "fold": "UNY"
    },
    "BINARY_OP": {
      "support": "execute",
      "hw_class": "ALU1",
      "fold": "RDX",
      "args": {
        "supported": [
          0,
          13,
          1,
          14,
          2,
          15,
          3,
          16,
          5,
          18,
          6,
          19,
          7,
          20,
          8,
          21,
          9,
          22,
          10,
          23,
          11,
          24,
          12,
          25,
          26
        ],
        "class_by_arg": {
          "ALUN": [
            2,
            15,
            5,
            18,
            6,
            19,
            8,
            21,
            11,
            24
          ],
          "OBJECT": [
            26,
            4,
            17
          ]
        },
        "obj_group_by_arg": {
          "OBJ_SEQ": [
            26,
            4,
            17
          ]
        }
      },
      "note": "3.14 routes subscript and matmul THROUGH BINARY_OP: oparg 26 (NB_SUBSCR, x[i]) and 4/17 (NB_MATRIX_MULTIPLY @) resolve to hw_class OBJECT (suppressed, not a missing-ALU gap); opargs in class_by_arg.ALUN -> ALUN; all other supported opargs -> ALU1."
    },
    "UNARY_NOT": {
      "support": "execute",
      "hw_class": "PRED",
      "fold": "UNY"
    },
    "TO_BOOL": {
      "support": "execute",
      "hw_class": "PRED",
      "fold": "UNY"
    },
    "COMPARE_OP": {
      "support": "execute",
      "hw_class": "PRED",
      "fold": "RDX",
      "selector_shift": 5,
      "supported_selectors": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "note": "Numeric + same-tag SHORT_STR/LONG_STR ==/!=; string ordering TYPE-traps; LONG_STR uses descriptor equality"
    },
    "POP_JUMP_IF_TRUE": {
      "support": "execute",
      "hw_class": "BRANCH",
      "fold": "BRC"
    },
    "POP_JUMP_IF_FALSE": {
      "support": "execute",
      "hw_class": "BRANCH",
      "fold": "BRC"
    },
    "JUMP_BACKWARD": {
      "support": "execute",
      "hw_class": "BRANCH",
      "fold": "BAR"
    },
    "JUMP_FORWARD": {
      "support": "execute",
      "hw_class": "BRANCH",
      "fold": "BAR"
    },
    "RETURN_VALUE": {
      "support": "execute",
      "hw_class": "BRANCH",
      "fold": "BAR"
    },
    "RAISE_VARARGS": {
      "support": "execute",
      "hw_class": "OBJECT",
      "fold": "BAR",
      "obj_group": "OBJ_EXC",
      "note": "oparg=1 builds OBK_EXCEPTION, walks co_exceptiontable, redirects or PY_TRAP_RAISE"
    },
    "PUSH_EXC_INFO": {
      "support": "execute",
      "hw_class": "OBJECT",
      "fold": "BAR",
      "obj_group": "OBJ_EXC",
      "note": "dmem exc-info push + stack [prev, exc]; sets active_exc_r"
    },
    "CHECK_EXC_MATCH": {
      "support": "execute",
      "hw_class": "OBJECT",
      "fold": "BAR",
      "obj_group": "OBJ_EXC",
      "note": "v1 exact type-handle match against active_exc.field0; [exc,type]->[exc,bool]"
    },
    "POP_EXCEPT": {
      "support": "execute",
      "hw_class": "OBJECT",
      "fold": "BAR",
      "obj_group": "OBJ_EXC",
      "note": "pop dmem exc-info node; restore active_exc_*; pop TOS prev"
    },
    "RERAISE": {
      "support": "execute",
      "hw_class": "OBJECT",
      "fold": "BAR",
      "obj_group": "OBJ_EXC",
      "note": "re-raise TOS through table walk; oparg=1 restores outer active first"
    },
    "RESUME": {
      "support": "strip",
      "hw_class": "BRANCH",
      "fold": "BAR"
    },
    "NOT_TAKEN": {
