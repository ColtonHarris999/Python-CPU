    },
    "STORE_FAST_LOAD_FAST": {
      "support": "execute",
      "hw_class": "REG",
      "fold": "BAR",
      "note": "executes fine (two RF accesses) but is a fold boundary"
    },
    "LOAD_FAST_BORROW_LOAD_FAST_BORROW": {
      "support": "execute",
      "hw_class": "REG",
      "fold": "SRC",
      "pushes": 2
    },
    "LOAD_FAST_LOAD_FAST": {
      "support": "execute",
      "hw_class": "REG",
      "fold": "SRC",
